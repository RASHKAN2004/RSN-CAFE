NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/rsn_cafe
# Use a long random string (32+ chars). Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_this_to_a_long_random_string_at_least_32_chars
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:3000

# ---- Cafe ----
CAFE_NAME=RSN CAFE
CAFE_PHONE=+94750519450
CURRENCY_LABEL=Rs.
TAX_RATE=0
SERVICE_CHARGE_RATE=0.10
DEFAULT_COUNTRY_CODE=94
TIMEZONE=Asia/Colombo
TZ_OFFSET_MINUTES=330

# ---- Admin account created by `npm run seed` ----
ADMIN_NAME=rashkan
ADMIN_PHONE=0750519450
ADMIN_PASSWORD=Rsn@4478

# ---- SMS / OTP ----
# console  = prints SMS in the terminal (development)
# twilio   = real SMS via Twilio
# notifylk = real SMS via Notify.lk (Sri Lanka)
SMS_PROVIDER=console
# Shows the OTP in the API response + UI ONLY when SMS_PROVIDER=console and NODE_ENV!=production
SHOW_DEV_OTP=true
# Owner/admin phone that gets an SMS for every new order (optional)
ADMIN_ALERT_PHONE=+94750519450

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# A Twilio number (+1555...) or a Messaging Service SID (MG...)
TWILIO_FROM=

NOTIFYLK_USER_ID=
NOTIFYLK_API_KEY=
NOTIFYLK_SENDER_ID=NotifyDEMO
